{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(sudo *)",
      "Bash(systemctl *)",
      "Bash(git *push* --force*)",
      "Bash(git *push* -f*)",
      "Bash(git *push* +*)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(*.env*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(python -m pip install *)",
      "Bash(python3 -m pip install *)",
      "Bash(.venv/bin/pip install *)",
      "Bash(.venv/bin/python -m pip install *)",
      "Bash(.venv/bin/python3 -m pip install *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo sync *)",
      "Bash(gh api *)"
    ]
  }
}
