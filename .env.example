# ---------------------------------------------------------------------------
# APEX environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to the repo — it is in .gitignore.
# NEVER commit data/apex.db — it is in .gitignore.
#
# Production deployment: change APEX_ENV to "production" and rotate
# ACTION_TOKEN_SECRET before exposing the service to the internet.
# See deploy/VPS_SETUP.md for the full deployment checklist.
# ---------------------------------------------------------------------------

# Runtime
# Use "production" on VPS — marks the runtime environment in logs and /status.
# "development" is the safe local default.
APEX_ENV=development
APEX_LOG_LEVEL=INFO
APEX_DB_PATH=./data/apex.db
APEX_PUBLIC_BASE_URL=

# Alert controls
# Set ALERTS_ENABLED=true only when you are ready to receive live alerts.
# Default false: bot runs, scans, logs — but does not send Pushover notifications.
ALERTS_ENABLED=false
# DRY_RUN_MODE=true adds [DRY RUN] prefix to suppressed-alert log lines.
DRY_RUN_MODE=true
# Which alert types to send. Options: SETUP_FORMING, CONFIRMED_SETUP, or both comma-separated.
ALERT_TYPES_ENABLED=CONFIRMED_SETUP

# FastAPI
APEX_HOST=127.0.0.1
APEX_PORT=8000

# Hyperliquid
HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# Market universe
SCAN_MODE=MAJOR_ONLY
MIN_24H_VOLUME_USD=25000000
PRIORITY_SYMBOLS=BTC,ETH,SOL,HYPE
EXCLUDED_SYMBOLS=
MAX_SYMBOLS=30

# Strategy timeframes
TREND_TIMEFRAME=15m
SETUP_TIMEFRAME=5m
ENTRY_TIMEFRAME=3m

# Indicators
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
ATR_PERIOD=14
VWAP_LOOKBACK_CANDLES=96
STOP_ATR_MULTIPLIER=1.25

# Risk
ACCOUNT_SIZE_USD=100
RISK_PER_TRADE_PCT=1
MAX_DAILY_PLANNED_LOSS_PCT=3
MAX_STOP_DISTANCE_PCT=4

# Alert throttles
CONFIRMED_ALERT_COOLDOWN_MINUTES=30
FORMING_ALERT_COOLDOWN_MINUTES=15
GLOBAL_CONFIRMED_ALERTS_PER_HOUR=5
SETUP_EXPIRATION_MINUTES=15
SNOOZE_MINUTES=15

# Paper trade tracking
FOLLOWUP_AFTER_ENTER_MINUTES=30

# Pushover
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
PUSHOVER_DEVICE=
PUSHOVER_DEFAULT_PRIORITY=0
PUSHOVER_CONFIRMED_PRIORITY=1
PUSHOVER_SOUND=pushover

# Action link security
# REQUIRED: replace with a strong random secret before deploying to a VPS.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# If left as the placeholder, APEX will log a warning on startup.
ACTION_TOKEN_SECRET=change-me-to-a-random-secret
ACTION_TOKEN_TTL_HOURS=48
