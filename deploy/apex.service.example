[Unit]
Description=APEX Hyperliquid Alert Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/apex
EnvironmentFile=/opt/apex/.env
ExecStart=/opt/apex/.venv/bin/python -m apex.main
Restart=always
RestartSec=5
User=apex
Group=apex

# Sandboxing — allows writes only to /opt/apex/data
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/opt/apex/data

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=apex

[Install]
WantedBy=multi-user.target
